# mapeamento das portas do node & db
PORT=3000
MONGO_PORT=27017

# secret para gerar o jwt
JWT_SECRET='seu-segredo'

# usuário e senha consumidos no docker-compose
MONGO_ROOT_USER=admin
MONGO_ROOT_PASS=admin123

# url consumida no mongoose -> substituir seu MONGO_ROOT_USER e MONGO_ROOT_PASS abaixo
MONGO_URI='mongodb://MONGO_ROOT_USER:MONGO_ROOT_PASS@mongodb:27017/scheduler?authSource=admin'

# admin criado após inicializar o banco
ADMIN_EMAIL=admin@admin.com
ADMIN_PASS=admin123

